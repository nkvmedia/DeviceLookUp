<UserControl x:Class="DeviceLookup.Views.SingleLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DeviceLookup.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="HideWhenEmpty" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideMtmWhenEmpty" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mtm}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ShieldPath" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WarrantyState}" Value="Active"><Setter Property="Fill" Value="{StaticResource GreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding WarrantyState}" Value="ExpiringSoon"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding WarrantyState}" Value="Expired"><Setter Property="Fill" Value="{StaticResource RedBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Lookup a device" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Enter or scan a serial number / service tag." Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Vendors}" SelectedIndex="{Binding VendorIndex, Mode=TwoWay}"
                          MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SerialBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Tag="e.g. PF4Q9WYF" Margin="0,0,10,0"
                         Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" FontSize="15">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LookupCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding LookupCommand}" MinWidth="110">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Lookup"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>

            <TextBlock Text="Enter a serial number above to see the model and warranty details."
                       Style="{StaticResource MutedText}" Margin="0,26,0,0"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource B2V}}"/>

            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasResult, Converter={StaticResource B2V}}">
                <Border Style="{StaticResource Card}" DataContext="{Binding Result}">
                    <StackPanel>
                        <!-- Status line -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource StatusBadgeGlyph}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Picture and details -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="170" Height="124" Background="{StaticResource PageBrush}" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                <Grid>
                                    <c:LaptopGraphic Margin="18">
                                        <c:LaptopGraphic.Style>
                                            <Style TargetType="c:LaptopGraphic">
                                                <Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </c:LaptopGraphic.Style>
                                    </c:LaptopGraphic>
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="10"
                                           Visibility="{Binding HasImage, Converter={StaticResource B2V}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource VendorTag}">
                                    <TextBlock Text="{Binding Manufacturer}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding Product}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,8" TextWrapping="Wrap"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Serial Number"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SerialNumber}" MinWidth="130"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Command="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding SerialNumber}">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="13"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,2" Style="{StaticResource HideWhenEmpty}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Model / Type"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Model}" MinWidth="130"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Command="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Model}">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="13"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,2" Style="{StaticResource HideMtmWhenEmpty}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MTM"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Mtm}" MinWidth="130"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Command="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Mtm}">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Warranty -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="NotFound"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrushSoft}" Margin="0,18,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ShieldPath}" Data="M12,2 L4,5 V11 C4,16 7.5,20.5 12,22 C16.5,20.5 20,16 20,11 V5 Z"/>
                                        <Path Data="M8,12 L11,15 L16,9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Warranty" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Style="{StaticResource WarrantyChip}">
                                    <TextBlock Text="{Binding WarrantyLabel}" Style="{StaticResource WarrantyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding WarrantyName}" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="36,8,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="36,8,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers><DataTrigger Binding="{Binding WarrantyState}" Value="Unknown"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Start date" Style="{StaticResource MutedText}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WarrantyStartText}" Margin="0,2" FontSize="13"/>
                                <TextBlock Grid.Row="1" Text="End date" Style="{StaticResource MutedText}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WarrantyEndText}" Margin="0,2" FontSize="13"/>
                                <TextBlock Grid.Row="2" Text="Remaining" Style="{StaticResource MutedText}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RemainingText}" Margin="0,2" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>

                        <!-- Notes and errors -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,4,0,0" Background="{StaticResource RedSoftBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Found"><Setter Property="Background" Value="{StaticResource AmberSoftBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearCommand}" MinWidth="90"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyResultCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Copy Result"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
