<UserControl x:Class="DeviceLookup.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DeviceLookup.Controls">
    <UserControl.Resources>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,5"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:LaptopGraphic Width="84" Height="60" Margin="0,0,20,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="About Device Lookup" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                        <TextBlock Text="A simple tool for IT service desk and asset management." Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="20,0,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Open Log Folder" Command="{Binding OpenLogCommand}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Visit Project Page" Command="{Binding OpenProjectCommand}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Check for Updates" Command="{Binding CheckUpdatesCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Changelog" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Height="280" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ChangelogText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="19"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Footer}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
