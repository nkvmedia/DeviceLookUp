<UserControl x:Class="DeviceLookup.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="OptionRow" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Providers" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="Enable Lenovo lookup" IsChecked="{Binding LenovoEnabled}" Margin="0,4"/>
                            <CheckBox Content="Enable Dell lookup" IsChecked="{Binding DellEnabled}" Margin="0,4"/>

                            <TextBlock Text="Dell lookup method" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                            <RadioButton GroupName="DellMode" Content="Public lookup (web)" IsChecked="{Binding IsPublicMode}" Margin="0,4"/>
                            <RadioButton GroupName="DellMode" Content="API preferred (use API when available)" IsChecked="{Binding IsApiPreferred}" Margin="0,4"/>
                            <RadioButton GroupName="DellMode" Content="API only (requires valid API credentials)" IsChecked="{Binding IsApiOnly}" Margin="0,4"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Dell blocks automated web lookups, so Dell devices need API credentials."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Other settings" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Concurrent lookups (bulk)" VerticalAlignment="Center" FontSize="13"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding ConcurrentLookups, Mode=TwoWay}" MinHeight="32"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Cache duration (days)" VerticalAlignment="Center" FontSize="13"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CacheDayOptions}" SelectedItem="{Binding CacheDays, Mode=TwoWay}" MinHeight="32"/>
                            </Grid>
                            <CheckBox Content="Use local cache" IsChecked="{Binding UseCache}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dell TechDirect API (optional)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Client ID" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding DellClientId, UpdateSourceTrigger=LostFocus}" Tag="Paste your Client ID"/>
                            <TextBlock Text="Client Secret" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="SecretBox" Style="{StaticResource FieldPasswordBox}" PasswordChanged="SecretBox_PasswordChanged"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Test API Connection" Command="{Binding TestCommand}" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Get these from Dell TechDirect: Services, Get support and replace parts, APIs, Request API Key (Warranty). The secret is stored encrypted for your Windows account."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Cache management" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Stores devices and pictures you looked up, so repeat lookups are instant."/>
                            <TextBlock Text="{Binding CacheInfo}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Clear Cache" Command="{Binding ClearCacheCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
