<UserControl x:Class="DeviceLookup.Views.BulkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="TileBorder" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Bulk device lookup" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Import a CSV file with serial numbers or service tags." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Import row -->
        <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Import CSV"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Content="Start lookup" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" Content="Stop" Margin="8,0,0,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource B2V}}"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding FileName}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" Foreground="{StaticResource TextBrush}"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding ImportInfo}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource MutedText}"/>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Vendors}" SelectedIndex="{Binding VendorIndex, Mode=TwoWay}" MinWidth="200" MinHeight="36" VerticalContentAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="Manufacturer:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
        </DockPanel>

        <!-- Progress -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="10" Foreground="{StaticResource GreenBrush}" Background="#E2E7EF" BorderThickness="0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" VerticalAlignment="Bottom" Margin="12,0,0,-2" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>

        <!-- Tiles -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,14,-12,0">
            <Border Style="{StaticResource TileBorder}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GreenBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="White" HorizontalAlignment="Center" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="{Binding FoundCount}" Style="{StaticResource TileNumber}"/><TextBlock Text="Found" Style="{StaticResource MutedText}"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AmberBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="White" HorizontalAlignment="Center" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="{Binding FailedCount}" Style="{StaticResource TileNumber}"/><TextBlock Text="Failed" Style="{StaticResource MutedText}"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource RedBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" Foreground="White" HorizontalAlignment="Center" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="{Binding NotFoundCount}" Style="{StaticResource TileNumber}"/><TextBlock Text="Not Found" Style="{StaticResource MutedText}"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE916;" Style="{StaticResource IconText}" Foreground="White" HorizontalAlignment="Center" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="{Binding ElapsedText}" Style="{StaticResource TileNumber}"/><TextBlock Text="Total time" Style="{StaticResource MutedText}"/></StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters -->
        <DockPanel Grid.Row="4" Margin="0,14,0,10" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Style="{StaticResource FieldTextBox}" Tag="Search in results…" Width="280"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock DockPanel.Dock="Left" Text="Show:" VerticalAlignment="Center" Margin="16,0,8,0" Style="{StaticResource MutedText}"/>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding StatusFilters}" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" MinWidth="120" MinHeight="36" VerticalContentAlignment="Center"/>
            <CheckBox DockPanel.Dock="Left" Content="Show failures only" IsChecked="{Binding FailuresOnly}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>

        <!-- Results -->
        <DataGrid Grid.Row="5" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding VisibleRows}"
                  ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Serial / Service Tag" Binding="{Binding SerialNumber}" Width="150"/>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="110"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="110"/>
                <DataGridTextColumn Header="MTM" Binding="{Binding Mtm}" Width="120"/>
                <DataGridTemplateColumn Header="Warranty" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding WarrantyLabel}" Style="{StaticResource WarrantyChipText}" FontWeight="Normal"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Error}">
                                <TextBlock Style="{StaticResource StatusGlyph}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Retry Failed" Command="{Binding RetryCommand}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearCommand}"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Export CSV"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
