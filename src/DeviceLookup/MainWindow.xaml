<Window x:Class="DeviceLookup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceLookup.Core.ViewModels;assembly=DeviceLookup.Core"
        xmlns:v="clr-namespace:DeviceLookup.Views"
        xmlns:c="clr-namespace:DeviceLookup.Controls"
        Title="{Binding WindowTitle}" Width="1120" Height="720" MinWidth="940" MinHeight="620"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <DataTemplate DataType="{x:Type vm:SingleLookupViewModel}"><v:SingleLookupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BulkViewModel}"><v:BulkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><v:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>

        <Style x:Key="ProviderDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#B8C0CC"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <c:LaptopGraphic Grid.Column="0" Width="52" Height="38" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Device Lookup" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Lenovo and Dell asset information" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource ProviderDot}">
                                <Style.Triggers><DataTrigger Binding="{Binding LenovoOn}" Value="True"><Setter Property="Fill" Value="{StaticResource GreenBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Lenovo" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrushSoft}" Margin="14,0"/>
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource ProviderDot}">
                                <Style.Triggers><DataTrigger Binding="{Binding DellOn}" Value="True"><Setter Property="Fill" Value="{StaticResource GreenBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Dell" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="22" Height="18">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Path Data="{Binding IconPath}" Stretch="Uniform" Width="16" Height="12" HorizontalAlignment="Left"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="1" Command="{Binding ApplyUpdateCommand}" Margin="10,0,10,14" Cursor="Hand"
                            Visibility="{Binding HasUpdate, Converter={StaticResource B2V}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" MaxWidth="110"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Page + notifications -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}"/>

                <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,20,20" Width="350" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,8,0,0" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Border CornerRadius="15">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Background" Value="{StaticResource GreenBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Background" Value="{StaticResource RedBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Progress"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE946;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Text" Value="&#xE73E;"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Text" Value="&#xE711;"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <c:Spinner HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <c:Spinner.Style>
                                                <Style TargetType="c:Spinner">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Progress"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </c:Spinner.Style>
                                        </c:Spinner>
                                    </Grid>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                            Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
