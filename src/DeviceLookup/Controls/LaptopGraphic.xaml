        <Canvas Width="120" Height="80">
            <Rectangle Canvas.Left="18" Canvas.Top="6" Width="84" Height="54" RadiusX="5" RadiusY="5" Fill="#2B2F36"/>
            <Rectangle Canvas.Left="23" Canvas.Top="11" Width="74" Height="44" RadiusX="2" RadiusY="2" Fill="#1D3E78"/>
            <Rectangle Canvas.Left="23" Canvas.Top="11" Width="74" Height="22" RadiusX="2" RadiusY="2" Fill="#2F62B5"/>
            <Path Data="M4,64 H116 L110,74 Q109,76 106,76 H14 Q11,76 10,74 Z" Fill="#B7BDC7"/>
